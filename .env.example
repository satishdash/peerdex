# Environments
PEERDEX_ENV=dev                         # dev | prod

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_VLM_MODEL=gpt-4o-mini
OPENAI_SYNTH_MODEL=gpt-4o-mini

# Storage URIs (swap to gs:// for prod)
PEERDEX_LANCEDB_URI=./lancedb
PEERDEX_CACHE_URI=./cache

# Docling model cache (never on GCS; bake into image in prod)
DOCLING_ARTIFACTS_PATH=./cache/docling-models
HF_HOME=./cache/docling-models/hf

# Concurrency / rate limit
PEERDEX_VLM_CONCURRENCY=20
PEERDEX_VLM_QUEUE=200
PEERDEX_OPENAI_RPM=500
PEERDEX_OPENAI_TPM=200000

# Logging
PEERDEX_LOG_LEVEL=INFO
