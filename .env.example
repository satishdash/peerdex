# Environments
PEERDEX_ENV=prod                        # dev | prod

# OpenAI
OPENAI_API_KEY=sk-replace-me
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-5.4-mini
OPENAI_LLM_TEMPERATURE=0
OPENAI_VLM_MODEL=gpt-5.4-nano
OPENAI_JUDGE_MODEL=gpt-5.4-mini

# Storage URIs (swap to gs:// for prod)
PEERDEX_LANCEDB_URI=${HOME}/.cache/peerdex/lancedb
PEERDEX_CACHE_URI=${HOME}/.cache/peerdex/cache
PEERDEX_VLM_CACHE=${HOME}/.cache/peerdex/vlm-images

# Docling model cache (never on GCS; bake into image in prod)
DOCLING_ARTIFACTS_PATH=${HOME}/.cache/peerdex/docling-models
HF_HOME=${HOME}/.cache/peerdex/docling-models/hf
DOCLING_RS_ARTIFACTS_PATH=
PDFIUM_LIB_PATH=~/.cache/docling.rs/pdfium/lib
DOCLING_RS_MAX_RENDER_PIXELS=40000

# Retrieval
PEERDEX_QUERY_TYPE=vector
PEERDEX_RERANKER=none
PEERDEX_RERANKER_MODEL=BAAI/bge-reranker-base
PEERDEX_ESCALATE=true
PEERDEX_VECTOR_INDEX_TYPE=IVF_SQ

# Concurrency / rate limit
PEERDEX_VLM_CONCURRENCY=8
PEERDEX_OPENAI_RPM=500
PEERDEX_OPENAI_TPM=200000

# Eval
PEERDEX_SUITES=config/suites.yaml
PEERDEX_EVAL_DIR=~/Documents/peerdex-eval

# Logging
PEERDEX_LOG_LEVEL=INFO
